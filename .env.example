# Metered API Key (for usage tracking)
METERED_API_KEY=your_metered_key

# Scheduling OAuth — client-side (builds the redirect URL)
VITE_CALENDLY_CLIENT_ID=your_calendly_client_id
VITE_CALCOM_CLIENT_ID=your_calcom_client_id

# Scheduling OAuth — server-side (Lambda secrets)
# These are NOT prefixed with VITE_ — they never reach the browser
CALENDLY_CLIENT_ID=your_calendly_client_id
CALENDLY_CLIENT_SECRET=your_calendly_secret
CALCOM_CLIENT_ID=your_calcom_client_id
CALCOM_CLIENT_SECRET=your_calcom_secret

# GitHub Integration (for CODE_REVIEW challenges)
# Get token from: https://github.com/settings/tokens
# Click: "Generate new token (classic)"
# Scopes needed:
#   - repo (for private repos)
#   - OR public_repo (for public repos only)
# Rate limits:
#   - Without token: 60 requests/hour
#   - With token: 5,000 requests/hour
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
