{
	"name": "pipe-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-28",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pipe-db",
			"database_id": "15afd1c5-640f-4ffc-b675-82d58c0eb548",
			"migrations_dir": "migrations"
		},
		{
			"binding": "pipe_db",
			"database_name": "pipe-db",
			"database_id": "15afd1c5-640f-4ffc-b675-82d58c0eb548",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "STORAGE",
			"bucket_name": "pipe-assets"
		}
	],
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"vectorize": [
		{
			"binding": "REPO_INDEX",
			"index_name": "repo-searchable-profiles",
			"remote": true
		},
		{
			"binding": "CANDIDATE_INDEX",
			"index_name": "candidate-searchable-profiles",
			"remote": true
		},
		{
			"binding": "ROLE_INDEX",
			"index_name": "role-searchable-profiles",
			"remote": true
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "VIDEO_ROOM",
				"class_name": "VideoRoom"
			},
			{
				"name": "DEV_CONTAINER",
				"class_name": "DevContainerDO"
			},
			{ "name": "VOICE_SESSION", "class_name": "VoiceSessionDO" }
		]
	},
	"containers": [
		{
			"class_name": "DevContainerDO",
			"image": "../../infra/containers/code-server/Dockerfile",
			"max_instances": 50,
			"instance_type": "standard-1"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_classes": [
				"VideoRoom"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"DevContainerDO"
			]
		},
		{ "tag": "v3", "new_classes": ["VoiceSessionDO"] }
	],
	// Environment variables — secrets go in .dev.vars for local dev
	// RESEND_API_KEY: set via `wrangler secret put RESEND_API_KEY` in production
	// APP_BASE_URL: defaults to https://pipe.build if not set
	// Dev container TTL knobs (ADR-037, Phase 3b)
	"vars": {
		"APP_BASE_URL": "http://localhost:5173",
		"API_BASE_URL": "http://localhost:8787",
		"OUTBOUND_EMAIL_FROM": "no-reply@hire-pipe.com",
		"DEV_CONTAINER_DEFAULT_TTL_SECONDS": "3600",
		"DEV_CONTAINER_MAX_TTL_SECONDS": "7200",
		"DEV_CONTAINER_WARN_BEFORE_SECONDS": "60",
		"PRIMARY_MATCH_STORE": "neo4j"
	},
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": ["no-reply@hire-pipe.com"]
		}
	],
	"env": {
		"dev": {
			"name": "pipe-api-dev",
			"vars": {
				"APP_BASE_URL": "https://app-dev.hire-pipe.com",
				"API_BASE_URL": "https://api-dev.hire-pipe.com",
				"OUTBOUND_EMAIL_FROM": "no-reply@hire-pipe.com",
				"VIDEO_ROOM_APP_URL": "https://room-dev.hire-pipe.com",
				"ENV": "dev",
				"DEV_AUTH_BYPASS": "true",
				"DEV_BYPASS_USER_ID": "dev-user",
				"DEV_CONTAINER_DEFAULT_TTL_SECONDS": "3600",
				"DEV_CONTAINER_MAX_TTL_SECONDS": "7200",
				"DEV_CONTAINER_WARN_BEFORE_SECONDS": "60",
				"PRIMARY_MATCH_STORE": "neo4j",
				"CANDIDATE_INGESTION_RETRY_LIMIT": "12"
			},
			"d1_databases": [
				{ "binding": "DB", "database_name": "pipe-db-test", "database_id": "0abe92df-9296-46f5-9f9d-a1fb1bcd3be1", "migrations_dir": "migrations" },
				{ "binding": "pipe_db", "database_name": "pipe-db-test", "database_id": "0abe92df-9296-46f5-9f9d-a1fb1bcd3be1", "remote": true }
			],
			"r2_buckets": [
				{ "binding": "STORAGE", "bucket_name": "pipe-assets-test" }
			],
			"ai": { "binding": "AI", "remote": true },
			"vectorize": [
				{ "binding": "REPO_INDEX", "index_name": "repo-profiles-test" },
				{ "binding": "CANDIDATE_INDEX", "index_name": "candidate-profiles-test" },
				{ "binding": "ROLE_INDEX", "index_name": "role-profiles-test" }
			],
			"send_email": [
				{
					"name": "EMAIL",
					"allowed_sender_addresses": ["no-reply@hire-pipe.com"]
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "VIDEO_ROOM", "class_name": "VideoRoom" },
					{ "name": "DEV_CONTAINER", "class_name": "DevContainerDO" },
					{ "name": "VOICE_SESSION", "class_name": "VoiceSessionDO" }
				]
			},
			"containers": [
				{
					"class_name": "DevContainerDO",
					"image": "../../infra/containers/code-server/Dockerfile",
					"max_instances": 50,
					"instance_type": "standard-1"
				}
			],
			"migrations": [
				{ "tag": "dev-v1", "new_classes": ["VideoRoom"] },
				{ "tag": "dev-v2", "new_classes": ["VoiceSessionDO"] },
				{ "tag": "dev-v3", "new_sqlite_classes": ["DevContainerDO"] }
			]
		},
		"staging": {
			"name": "pipe-api-staging",
			"vars": {
				"APP_BASE_URL": "https://staging.pipe.build"
			},
			// TODO: replace <STAGING_DB_ID> with the actual D1 database ID after provisioning
			"d1_databases": [
				{ "binding": "DB", "database_name": "pipe-staging", "database_id": "<STAGING_DB_ID>", "migrations_dir": "migrations" }
			],
			"r2_buckets": [
				{ "binding": "STORAGE", "bucket_name": "pipe-assets-staging" }
			],
			"vectorize": [
				{ "binding": "REPO_INDEX", "index_name": "repo-profiles-staging" },
				{ "binding": "CANDIDATE_INDEX", "index_name": "candidate-profiles-staging" },
				{ "binding": "ROLE_INDEX", "index_name": "role-profiles-staging" }
			]
		},
		"test": {
			"name": "pipe-api-test",
			"vars": {
				"APP_BASE_URL": "https://pipe-app-test.pages.dev",
				"API_BASE_URL": "https://pipe-api-test.workers.dev",
				"ENV": "test",
				"DEV_CONTAINER_DEFAULT_TTL_SECONDS": "3600",
				"DEV_CONTAINER_MAX_TTL_SECONDS": "7200",
				"DEV_CONTAINER_WARN_BEFORE_SECONDS": "60",
				"PRIMARY_MATCH_STORE": "neo4j"
			},
			"d1_databases": [
				{ "binding": "DB", "database_name": "pipe-db-test", "database_id": "0abe92df-9296-46f5-9f9d-a1fb1bcd3be1", "migrations_dir": "migrations" }
			],
			"r2_buckets": [
				{ "binding": "STORAGE", "bucket_name": "pipe-assets-test" }
			],
			"ai": { "binding": "AI", "remote": true },
			"vectorize": [
				{ "binding": "REPO_INDEX", "index_name": "repo-profiles-test" },
				{ "binding": "CANDIDATE_INDEX", "index_name": "candidate-profiles-test" },
				{ "binding": "ROLE_INDEX", "index_name": "role-profiles-test" }
			],
			"durable_objects": {
				"bindings": [
					{ "name": "VIDEO_ROOM", "class_name": "VideoRoom" },
					{ "name": "VOICE_SESSION", "class_name": "VoiceSessionDO" }
				]
			},
			"migrations": [
				{ "tag": "test-v1", "new_classes": ["VideoRoom"] },
				{ "tag": "test-v2", "new_classes": ["VoiceSessionDO"] }
			]
		},
		"production": {
			"name": "pipe-api",
			"vars": {
				"APP_BASE_URL": "https://app.hire-pipe.com",
				"API_BASE_URL": "https://app.hire-pipe.com",
				"OUTBOUND_EMAIL_FROM": "no-reply@hire-pipe.com",
				"VIDEO_ROOM_APP_URL": "https://room.hire-pipe.com",
				"DEV_CONTAINER_DEFAULT_TTL_SECONDS": "3600",
				"DEV_CONTAINER_MAX_TTL_SECONDS": "7200",
				"DEV_CONTAINER_WARN_BEFORE_SECONDS": "60",
				"PRIMARY_MATCH_STORE": "neo4j"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "pipe-db",
					"database_id": "15afd1c5-640f-4ffc-b675-82d58c0eb548",
					"migrations_dir": "migrations"
				},
				{
					"binding": "pipe_db",
					"database_name": "pipe-db",
					"database_id": "15afd1c5-640f-4ffc-b675-82d58c0eb548",
					"remote": true
				}
			],
			"r2_buckets": [
				{ "binding": "STORAGE", "bucket_name": "pipe-assets" }
			],
			"ai": { "binding": "AI", "remote": true },
			"vectorize": [
				{ "binding": "REPO_INDEX", "index_name": "repo-searchable-profiles", "remote": true },
				{ "binding": "CANDIDATE_INDEX", "index_name": "candidate-searchable-profiles", "remote": true },
				{ "binding": "ROLE_INDEX", "index_name": "role-searchable-profiles", "remote": true }
			],
			"send_email": [
				{
					"name": "EMAIL",
					"allowed_sender_addresses": ["no-reply@hire-pipe.com"]
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "VIDEO_ROOM", "class_name": "VideoRoom" },
					{ "name": "DEV_CONTAINER", "class_name": "DevContainerDO" },
					{ "name": "VOICE_SESSION", "class_name": "VoiceSessionDO" }
				]
			},
			"containers": [
				{
					"class_name": "DevContainerDO",
					"image": "../../infra/containers/code-server/Dockerfile",
					"max_instances": 50,
					"instance_type": "standard-1"
				}
			]
		}
	}
}
