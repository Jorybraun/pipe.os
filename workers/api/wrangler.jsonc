{
	"name": "pipe-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-28",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pipe-dev",
			// Placeholder: wrangler dev uses local SQLite automatically.
			// Replace with your real database_id after running:
			//   npx wrangler d1 create pipe-dev
			"database_id": "local",
			"migrations_dir": "migrations"
		},
		{
			"binding": "pipe_db",
			"database_name": "pipe-db",
			"database_id": "15afd1c5-640f-4ffc-b675-82d58c0eb548",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "STORAGE",
			// Wrangler dev emulates R2 locally — no bucket needs to exist.
			// For production, create the bucket first:
			//   npx wrangler r2 bucket create pipe-assets
			"bucket_name": "pipe-assets"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"containers": [
		{
			"class_name": "DevContainerDO",
			"image": "../../containers/code-server/Dockerfile",
			"max_instances": 50,
			"instance_type": "standard-1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "VIDEO_ROOM",
				"class_name": "VideoRoom"
			},
			{
				"name": "DEV_CONTAINER",
				"class_name": "DevContainerDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_classes": [
				"VideoRoom"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"DevContainerDO"
			]
		}
	],
	// Environment variables — secrets go in .dev.vars for local dev
	// RESEND_API_KEY: set via `wrangler secret put RESEND_API_KEY` in production
	// APP_BASE_URL: defaults to https://pipe.build if not set
	// Dev container TTL knobs (ADR-037, Phase 3b)
	"vars": {
		"APP_BASE_URL": "http://localhost:5173",
		"DEV_CONTAINER_DEFAULT_TTL_SECONDS": "3600",
		"DEV_CONTAINER_MAX_TTL_SECONDS": "7200",
		"DEV_CONTAINER_WARN_BEFORE_SECONDS": "60"
	}
}