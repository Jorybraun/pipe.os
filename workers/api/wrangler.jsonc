{
  "name": "pipe-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-28",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pipe-dev",
      // Placeholder: wrangler dev uses local SQLite automatically.
      // Replace with your real database_id after running:
      //   npx wrangler d1 create pipe-dev
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      // Wrangler dev emulates R2 locally — no bucket needs to exist.
      // For production, create the bucket first:
      //   npx wrangler r2 bucket create pipe-assets
      "bucket_name": "pipe-assets"
    }
  ]
}
