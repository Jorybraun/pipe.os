{
  "name": "pipe-api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "bench:routes": "tsx scripts/benchmarkApiRoutes.ts",
    "review-graph:readiness": "tsx scripts/checkReviewChallengeGraphReadiness.ts --json",
    "review-graph:remote-readiness": "tsx scripts/checkReviewChallengeGraphReadiness.ts --remote --json",
    "review-graph:remote-schema-readiness": "tsx scripts/checkReviewChallengeGraphReadiness.ts --remote --schema-only --json",
    "review-graph:rollout-gate": "tsx scripts/checkReviewChallengeGraphReadiness.ts --remote --require-github",
    "review-graph:migration-plan": "tsx scripts/checkReviewGraphMigrationPlan.ts",
    "review-graph:migrate-production": "wrangler d1 migrations apply pipe-db --env production --remote",
    "review-graph:backfill-remote": "tsx scripts/backfillReviewChallengePackets.ts --remote",
    "review-graph:backfill-report-gate": "tsx scripts/checkReviewGraphBackfillReport.ts",
    "matching-eval:readiness": "tsx scripts/evaluateMatching.ts --remote --check-latest-production-pass",
    "review-judge:verify": "tsx scripts/verifyCodeReviewJudgeExamples.ts --require-replay-ready --json",
    "review-packets:repair-profiles": "tsx scripts/backfillReviewPacketReviewProfiles.ts"
  },
  "dependencies": {
    "@clerk/backend": "^1.19.2",
    "@cloudflare/containers": "^0.3.0",
    "@cloudflare/workerd-linux-64": "^1.20260609.1",
    "@esbuild/linux-x64": "^0.21.5",
    "esbuild": "^0.21.5",
    "hono": "^4.6.20",
    "neo4j-driver": "^6.0.1",
    "resend": "^6.10.0",
    "unpdf": "^1.6.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "@vitest/coverage-v8": "^2.1.8",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.78.0"
  }
}
